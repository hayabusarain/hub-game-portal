// 2026-11〜（案D、docs/PLAN_D_2026-10-31.md）。ポータルの記事ページを閉じ、hub-game.com の直下に置くファイルだけを配る。
// スクリプト（main）は持たない。out/ の静的アセットだけを返す。中身は scripts/build_root.mjs が root/ と public/ から写す。
//
// **routes の hub-game.com（カスタムドメイン）は消さない。** この Worker が apex の DNS レコードの持ち主で、
// 消すと hub-game.com の DNS ごと外れ、/hok と /mlbb にも届かなくなる。/hok* と /mlbb* は各サイトの Worker のルートが先に受ける。
// 閉じる前の設定（言語の振り分けのスクリプト worker/entry.js を通していた）は portal-final-2026-11 のタグにある。
//
// 手元の確認: npm run build のあと npx wrangler dev
//   （止めるときは親の npx ごと止める。子の workerd が out/ を掴み、次のビルドが EPERM で止まる）
{
  "name": "hub-game-portal",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "hub-game.com", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    // 見つからないパスは out/404.html を 404 で返す（閉じた /ja/about なども、ここに落ちる）
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
